{
  "name": "rn-workout-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 8096 --max-workers 2",
    "dev": "expo start --port 8096 --max-workers 2",
    "android": "expo start --android --port 8096",
    "build": "expo export --platform android --output-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.22.0",
    "@react-navigation/native": "7.5.2",
    "@react-navigation/native-stack": "7.21.1",
    "@tanstack/react-query": "5.108.3",
    "expo": "58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "58.0.16",
    "expo-secure-store": "58.0.3",
    "expo-status-bar": "58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/utils/**/*.ts",
      "src/api/errors.ts"
    ]
  }
}
