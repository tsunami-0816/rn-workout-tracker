{
  "rootDir": "..",
  "testEnvironment": "node",
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "useESM": true, "tsconfig": "tsconfig.spec.json" }]
  },
  "testMatch": ["<rootDir>/test/**/*.e2e-spec.ts"],
  "moduleFileExtensions": ["ts", "js", "json"],
  "testTimeout": 30000
}
