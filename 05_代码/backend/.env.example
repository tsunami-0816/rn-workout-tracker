# 复制为 .env 后填真实值；此处只有占位，禁止提交真实 secret
DATABASE_URL="postgresql://postgres:<password>@127.0.0.1:5434/rn_workout?schema=public"
PORT=8094
TZ=Asia/Shanghai
NODE_ENV=development

# 必填：缺失会直接启动失败（见 src/app.module.ts 的启动校验）
JWT_SECRET="<32 字节随机串>"
JWT_EXPIRES_IN=7d

# 必填：演示验证码（仅演示环境）
DEMO_CODE="123456"
SEND_CODE_COOLDOWN_SEC=60

# 版本接口：默认读项目根 release.json（改文件立即生效）；env 只在该字段缺失时兜底
# APP_VERSION=
# APP_BUILD_NO=
# APK_URL=
# APP_NOTES=

RN_CACHE=memory
