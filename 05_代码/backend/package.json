{
  "name": "rn-workout-backend",
  "version": "1.0.0",
  "private": true,
  "description": "rn-mobile-app-release 后端：NestJS 12 + Prisma 7 + PostgreSQL 16",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node --max-old-space-size=512 dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "openapi": "node dist/tools/export-openapi.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.unit.js --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.unit.js --runInBand",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.unit.js --coverage --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.0",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/swagger": "12.1.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "dotenv": "^17.2.3",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
