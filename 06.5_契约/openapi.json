    "/api/plans/{id}/exercises": {
      "get": {
        "operationId": "PlanController_exercises",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
