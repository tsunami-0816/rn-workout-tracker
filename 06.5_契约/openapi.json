          {
            "bearer": []
          }
        ],
        "summary": "全站用户（脱敏）",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/admin/stats/summary": {
      "get": {
        "operationId": "AdminController_summary",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "全站汇总（用户数 / 训练数 / 总容量）",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/app/version": {
      "get": {
        "operationId": "VersionController_getVersion",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "最新版本信息（读 release.json + env 覆盖）",
        "tags": [
          "app"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "HealthController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "服务与数据库健康状态",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "RN Workout API",
    "description": "rn-mobile-app-release 后端契约（20 端点）",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SendCodeDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "13900139000",
            "description": "11 位中国大陆手机号"
          }
        },
        "required": [
          "phone"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "13900139000"
          },
          "code": {
            "type": "string",
            "example": "123456",
            "description": "6 位演示验证码"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "StartWorkoutDto": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "planId"
        ]
      },
      "CreateSetDto": {
        "type": "object",
        "properties": {
          "exerciseId": {
            "type": "number",
            "example": 7
          },
          "setNo": {
            "type": "number",
            "example": 1,
            "description": "组号 1-10（与 exercise_id 组成幂等键）"
          },
          "weight": {
            "type": "number",
            "example": 40,
            "description": "重量 kg（0-9999.99）"
          },
          "reps": {
            "type": "number",
            "example": 10,
            "description": "次数 0-50"
          },
          "done": {
            "type": "boolean",
            "example": true,
            "description": "是否已完成（容量只算 true 的组）"
          }
        },
        "required": [
          "exerciseId",
          "setNo",
          "weight",
          "reps",
          "done"
        ]
      },
      "UpdateSetDto": {
        "type": "object",
        "properties": {
          "weight": {
            "type": "number",
            "example": 42.5
          },
          "reps": {
            "type": "number",
            "example": 8
          },
          "done": {
            "type": "boolean",
            "example": true
          }
        }
      }
    }
  }
}
