          }
        },
        "summary": "当前用户（手机号脱敏）",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/plans": {
      "get": {
        "operationId": "PlanController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "我的三日分化计划 + 本周完成度 + 今日推荐",
        "tags": [
          "plans"
        ]
      }
    },
    "/api/plans/current": {
      "get": {
        "operationId": "PlanController_current",
        "parameters": [],
        "responses": {
          "200": {
