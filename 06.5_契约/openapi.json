        ]
      }
    },
    "/api/workouts": {
      "get": {
        "operationId": "WorkoutController_list",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "size",
            "required": false,
            "in": "query",
            "schema": {
              "example": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "我的训练记录（分页，size 上限 50）",
        "tags": [
          "workouts"
        ]
      }
    },
    "/api/workouts/start": {
      "post": {
        "operationId": "WorkoutController_start",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartWorkoutDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "开始今日训练（同一天复用同一 workout）",
        "tags": [
          "workouts"
        ]
      }
    },
    "/api/workouts/{id}": {
      "get": {
        "operationId": "WorkoutController_detail",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "训练详情（含组次）",
        "tags": [
          "workouts"
        ]
      }
    },
    "/api/workouts/{id}/sets": {
      "post": {
        "operationId": "WorkoutController_createSet",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSetDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "提交组次（复合唯一键幂等，事务重算容量）",
        "tags": [
          "workouts"
        ]
      }
    },
    "/api/workouts/{id}/sets/{setId}": {
      "patch": {
        "operationId": "WorkoutController_updateSet",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "setId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSetDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "修改组次（重量/次数/完成态）",
        "tags": [
          "workouts"
        ]
      },
      "delete": {
        "operationId": "WorkoutController_deleteSet",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "setId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "删除组次（容量回落）",
        "tags": [
          "workouts"
        ]
      }
    },
    "/api/workouts/{id}/finish": {
      "post": {
        "operationId": "WorkoutController_finish",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "结束本次训练（幂等）",
        "tags": [
          "workouts"
        ]
      }
    },
    "/api/stats/weekly": {
      "get": {
        "operationId": "StatsController_weekly",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "本周打卡天数 / 总容量 / 近 4 周序列",
        "tags": [
          "stats"
        ]
      }
    },
    "/api/stats/history": {
      "get": {
        "operationId": "StatsController_history",
        "parameters": [
          {
            "name": "weeks",
            "required": false,
            "in": "query",
            "schema": {
              "example": 4,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "历史训练列表（按周回溯，最多 100 条）",
        "tags": [
          "stats"
        ]
      }
    },
    "/api/admin/workouts": {
      "get": {
        "operationId": "AdminController_workouts",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "size",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "schema": {
              "example": "2026-11-01",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "schema": {
              "example": "2026-11-30",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "全站训练记录（脱敏 + 日期筛选，size 上限 50）",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/admin/users": {
      "get": {
        "operationId": "AdminController_users",
        "parameters": [
          {
